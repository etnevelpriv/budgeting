<%-include("header")%>

    <form action="/search" method="get">
        <div class="input-group">
            <label for="name">Name</label>
            <input type="text" name="name" id="nameInput">
        </div>
        <input type="submit" value="Search">
    </form>
    <form action="/expensive" method="get">
        <div class="input-group">
            <label for="amount">Min. Amount</label>
            <input type="number" name="amount" id="amountInput">
        </div>
        <input type="submit" value="Search">
    </form>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Amount</th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            <%koltesek.forEach((koltes)=>{ %>
                <tr class="<%=koltes.category%>-sor">
                    <td>
                        <%=koltes.name%>
                    </td>
                    <td>
                        <%=koltes.amount%>
                    </td>
                    <td>
                        <%=koltes.category%>
                    </td>
                </tr>
                <%})%>
        </tbody>
    </table>
<%-include("footer")%>
